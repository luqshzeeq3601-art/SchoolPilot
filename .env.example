# ==============================================================================
# SchoolPilot — Environment Configuration Template
# Copy this file to '.env' before starting the application: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=schoolops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/schoolops

# Local AI Engine (Ollama running natively on host)
# Under Docker Compose on Windows, use host.docker.internal to reach host Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b

# n8n Automation Engine (Self-Hosted)
N8N_PORT=5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook/
N8N_API_KEY=schoolpilot_n8n_secret_key_2026
N8N_ENCRYPTION_KEY=schoolpilot_32_character_key_123456

# JWT Authentication & Security
# WARNING: Change JWT_SECRET to a unique cryptographically random 32+ character key in production
JWT_SECRET=schoolpilot_jwt_secret_key_production_32chars_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
UPLOAD_DIR=/app/uploads
